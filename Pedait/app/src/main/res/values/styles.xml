<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CustomEditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:background">@android:drawable/edit_text</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="EditProfileField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@android:drawable/edit_text</item>
    </style>

    <style name="ProfileField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@android:drawable/editbox_background</item>
        <item name="android:padding">12dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="RoundedImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="DayHeader">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:background">#3B82F6</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:padding">6dp</item> <!-- dikurangi -->
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item> <!-- dikurangi -->
    </style>

    <style name="JadwalBox">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:padding">6dp</item> <!-- dikurangi -->
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">10sp</item> <!-- dikurangi -->
        <item name="android:gravity">center</item>
        <item name="android:maxLines">5</item>
        <item name="android:ellipsize">none</item>
        <item name="android:lineSpacingExtra">2dp</item> <!-- dikurangi -->
        <item name="android:background">#FFFFFF</item>
    </style>

    <style name="RestBox">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:padding">6dp</item> <!-- dikurangi -->
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">10sp</item> <!-- dikurangi -->
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">none</item>
        <item name="android:lineSpacingExtra">2dp</item> <!-- dikurangi -->
        <item name="android:background">#9CA3AF</item>
    </style>

    <style name="EmptyBox">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
    </style>

</resources>